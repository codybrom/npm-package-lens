{
  "name": "npm-package-lens",
  "displayName": "npm Package Lens",
  "description": "Hover and inline annotations showing outdated dependencies directly in package.json",
  "version": "0.1.0",
  "publisher": "codybromley",
  "engines": {
    "vscode": "^1.130.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:json",
    "onLanguage:jsonc"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "main": "./out/src/extension",
  "scripts": {
    "vscode:prepublish": "tsc",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js",
    "pretest:unit": "npm run compile",
    "test:unit": "mocha",
    "test:all": "npm run test:unit && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "semver-utils": "^1.1.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.2",
    "@types/semver-utils": "^1.1.3",
    "@types/vscode": "^1.125.0",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^63.3.2",
    "glob": "^13.0.6",
    "mocha": "^11.7.6",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
