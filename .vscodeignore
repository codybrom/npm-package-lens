# Only dist/ (the esbuild bundle + its sourcemap) ships. Everything else
# here is either source that got bundled in, or dev-only tooling.
src/**
test/**
out/**
node_modules/**
esbuild.js

# Editor / repo tooling, not needed at runtime
.vscode/**
.github/**
.claude/**
.gitignore
.prettierignore
.prettierrc.json
.mocharc.json
eslint.config.mjs
tsconfig.json
